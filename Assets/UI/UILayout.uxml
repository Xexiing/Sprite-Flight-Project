<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score : 0" name="ScoreLabel" style="justify-content: flex-start; align-self: center; font-size: 15px; color: rgb(0, 255, 191); -unity-text-align: middle-center; -unity-font-style: bold; border-top-width: 1px; border-left-color: rgb(255, 255, 255); border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); height: 32px; width: 113px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
    <ui:Button text="Restart" name="RestartButton" style="align-self: center; position: absolute; top: 40%; font-size: 20px; -unity-font-style: bold; color: rgb(255, 39, 0); background-color: rgba(0, 0, 0, 0.314); border-top-width: 1px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; border-top-left-radius: 15px; border-left-color: rgb(255, 0, 0); border-right-color: rgb(255, 0, 0); border-top-color: rgb(255, 0, 0); border-bottom-color: rgb(255, 0, 0);"/>
    <ui:Label text="High Score : 0 " name="HighScoreLabel" style="justify-content: center; align-content: center; align-self: center; color: rgb(0, 255, 204); font-size: 18px; -unity-text-align: middle-left; border-top-color: rgb(255, 0, 0); background-color: rgb(255, 0, 37); border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 10px; border-right-width: 1px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; border-left-color: rgb(255, 0, 0); border-right-color: rgb(255, 0, 0); border-bottom-color: rgb(255, 0, 0);"/>
</ui:UXML>
